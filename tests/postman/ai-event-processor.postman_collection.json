{
  "info": {
    "name": "AI Event Processor — Full API Suite",
    "description": "All endpoints: forecasting-service, diagnostic-service, ingestion health, event-archiver metrics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "forecasting_url", "value": "http://localhost:9081" },
    { "key": "diagnostic_url",  "value": "http://localhost:9082" },
    { "key": "ingestion_url",   "value": "http://localhost:9080" },
    { "key": "archiver_url",    "value": "http://localhost:9083" }
  ],
  "item": [
    {
      "name": "Ingestion Service",
      "item": [
        {
          "name": "Liveness probe",
          "request": { "method": "GET", "url": "{{ingestion_url}}/actuator/health/liveness" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
          ]}}]
        },
        {
          "name": "Readiness probe",
          "request": { "method": "GET", "url": "{{ingestion_url}}/actuator/health/readiness" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
          ]}}]
        },
        {
          "name": "Prometheus metrics",
          "request": { "method": "GET", "url": "{{ingestion_url}}/actuator/prometheus" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has kafka metrics', () => pm.expect(pm.response.text()).to.include('kafka'));"
          ]}}]
        }
      ]
    },
    {
      "name": "Forecasting Service",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{forecasting_url}}/health" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Ready",
          "request": { "method": "GET", "url": "{{forecasting_url}}/ready" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Get thresholds",
          "request": { "method": "GET", "url": "{{forecasting_url}}/thresholds" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('is object', () => pm.expect(pm.response.json()).to.be.an('object'));",
            "pm.globals.set('forecasting_component', Object.keys(pm.response.json())[0]);"
          ]}}]
        },
        {
          "name": "Override threshold (low — triggers alert)",
          "request": {
            "method": "PUT",
            "url": "{{forecasting_url}}/thresholds/ingestion-service",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"cpu_utilisation\": 0.01}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200 or 204', () => pm.expect(pm.response.code).to.be.oneOf([200,204]));"
          ]}}]
        },
        {
          "name": "Run forecast cycle",
          "request": {
            "method": "POST",
            "url": "{{forecasting_url}}/forecast",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"component_id\": \"ingestion-service\", \"forecast_window_minutes\": 60}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "List alerts",
          "request": { "method": "GET", "url": "{{forecasting_url}}/alerts" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));",
            "const alerts = pm.response.json(); if (alerts.length > 0) pm.globals.set('alert_id', alerts[0].id);"
          ]}}]
        },
        {
          "name": "Alerts summary",
          "request": { "method": "GET", "url": "{{forecasting_url}}/alerts/summary" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has open count', () => pm.expect(pm.response.json()).to.have.property('open'));"
          ]}}]
        },
        {
          "name": "Get predictions",
          "request": { "method": "GET", "url": "{{forecasting_url}}/predictions" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}]
        },
        {
          "name": "Get predictions history",
          "request": { "method": "GET", "url": "{{forecasting_url}}/predictions/history" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Prometheus metrics",
          "request": { "method": "GET", "url": "{{forecasting_url}}/metrics" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has forecast metric', () => pm.expect(pm.response.text()).to.include('forecast'));"
          ]}}]
        }
      ]
    },
    {
      "name": "Diagnostic Service",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{diagnostic_url}}/health" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Ready",
          "request": { "method": "GET", "url": "{{diagnostic_url}}/ready" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Get detection threshold",
          "request": { "method": "GET", "url": "{{diagnostic_url}}/thresholds" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has threshold', () => pm.expect(pm.response.json()).to.have.property('threshold'));"
          ]}}]
        },
        {
          "name": "Get model info",
          "request": { "method": "GET", "url": "{{diagnostic_url}}/model" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has model_version', () => pm.expect(pm.response.json()).to.have.property('model_version'));"
          ]}}]
        },
        {
          "name": "Score normal event (warm-up 1)",
          "request": {
            "method": "POST",
            "url": "{{diagnostic_url}}/score/warm-1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"event\":{\"source\":\"checkout\",\"type\":\"request\",\"payload\":{\"latency_ms\":100}}}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has score', () => pm.expect(pm.response.json()).to.have.property('score'));"
          ]}}]
        },
        {
          "name": "Score normal event (warm-up 2)",
          "request": {
            "method": "POST",
            "url": "{{diagnostic_url}}/score/warm-2",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"event\":{\"source\":\"checkout\",\"type\":\"request\",\"payload\":{\"latency_ms\":105}}}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Score anomalous event (spike)",
          "request": {
            "method": "POST",
            "url": "{{diagnostic_url}}/score/spike-1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"event\":{\"source\":\"checkout\",\"type\":\"request\",\"payload\":{\"latency_ms\":9000}}}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has score field', () => pm.expect(pm.response.json()).to.have.property('score'));",
            "pm.test('score is number', () => pm.expect(pm.response.json().score).to.be.a('number'));"
          ]}}]
        },
        {
          "name": "Update detection threshold",
          "request": {
            "method": "PUT",
            "url": "{{diagnostic_url}}/thresholds",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"threshold\": 0.8}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200 or 204', () => pm.expect(pm.response.code).to.be.oneOf([200,204]));"
          ]}}]
        },
        {
          "name": "Prometheus metrics",
          "request": { "method": "GET", "url": "{{diagnostic_url}}/metrics" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has anomaly metric', () => pm.expect(pm.response.text()).to.include('anomaly'));"
          ]}}]
        }
      ]
    },
    {
      "name": "Event Archiver",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{archiver_url}}/health" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Prometheus metrics",
          "request": { "method": "GET", "url": "{{archiver_url}}/metrics" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has archive metric', () => pm.expect(pm.response.text()).to.include('archive'));"
          ]}}]
        }
      ]
    }
  ]
}
